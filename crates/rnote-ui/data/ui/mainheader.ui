<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <template class="RnMainHeader" parent="GtkWidget">
    <property name="layout-manager">
      <object class="GtkBinLayout"/>
    </property>
    <child>
      <object class="AdwHeaderBar" id="headerbar">
        <property name="centering-policy">loose</property>
        <property name="vexpand">false</property>
        <property name="title-widget">
          <object class="GtkStack" id="title_stack">
            <property name="hhomogeneous">false</property>
            <property name="vhomogeneous">true</property>
            <property name="transition-type">crossfade</property>
            <property name="hexpand">true</property>
            <child>
              <object class="GtkStackPage">
                <property name="name">breadcrumbs_page</property>
                <property name="child">
                  <object class="GtkScrolledWindow" id="path_bar_scrolled">
                    <property name="vscrollbar-policy">never</property>
                    <property name="hscrollbar-policy">automatic</property>
                    <property name="propagate-natural-width">true</property>
                    <property name="halign">center</property>
                    <property name="valign">center</property>
                    <property name="child">
                      <object class="GtkBox" id="breadcrumbs_box">
                        <property name="spacing">0</property>
                        <property name="valign">center</property>
                        <property name="halign">center</property>
                        <child>
                          <object class="GtkButton" id="path_dir_button">
                            <property name="child">
                              <object class="AdwButtonContent" id="path_dir_content">
                                <property name="icon-name">folder-symbolic</property>
                                <property name="label">Documents</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="path_separator">
                            <property name="label">/</property>
                            <property name="margin-start">4</property>
                            <property name="margin-end">4</property>
                            <style>
                              <class name="dimmed"/>
                            </style>
                          </object>
                        </child>
                        <child>
                          <object class="GtkButton" id="path_file_button">
                            <property name="child">
                              <object class="AdwButtonContent" id="path_file_content">
                                <property name="icon-name">text-x-generic-symbolic</property>
                                <property name="label">New Document.txt</property>
                              </object>
                            </property>
                          </object>
                        </child>
                        <child>
                          <object class="GtkLabel" id="main_title_unsaved_indicator">
                            <property name="label">•</property>
                            <property name="margin-start">4</property>
                            <property name="margin-end">4</property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </child>
          </object>
        </property>
        <child type="start">
          <object class="GtkBox" id="quickactions_box">
            <property name="limit-events">true</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkBox">
                <property name="spacing">3</property>
                <child>
                  <object class="GtkToggleButton" id="left_sidebar_reveal_toggle">
                    <property name="icon_name">sidebar-reveal-symbolic</property>
                    <property name="tooltip_text" translatable="yes">Show/Hide Sidebar</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="icon-name">tab-new-symbolic</property>
                    <property name="action-name">win.new-tab</property>
                    <property name="tooltip-text" translatable="yes">New Tab</property>
                  </object>
                </child>
                <child>
                  <object class="GtkButton">
                    <property name="icon-name">view-grid-symbolic</property>
                    <property name="action-name">overview.open</property>
                    <property name="tooltip-text" translatable="yes">View Open Tabs</property>
                  </object>
                </child>
                <child>
                  <object class="GtkToggleButton">
                    <property name="icon-name">focus-mode-symbolic</property>
                    <property name="action-name">win.focus-mode</property>
                    <property name="tooltip-text" translatable="yes">Focus Mode</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
        <child type="end">
          <object class="GtkBox">
            <property name="limit-events">true</property>
            <property name="spacing">3</property>
            <child>
              <object class="GtkToggleButton" id="search_toggle">
                <property name="icon-name">system-search-symbolic</property>
                <property name="tooltip-text" translatable="yes">Search</property>
              </object>
            </child>
            <child>
              <object class="GtkButton">
                <property name="tooltip-text" translatable="yes">Save Document</property>
                <property name="icon-name">save-symbolic</property>
                <property name="action-name">win.save-doc</property>
              </object>
            </child>
            <child>
              <object class="GtkToggleButton" id="right_sidebar_reveal_toggle">
                <property name="icon_name">sidebar-reveal-symbolic</property>
                <property name="tooltip_text" translatable="yes">Show/Hide Sidebar</property>
              </object>
            </child>
            <child>
              <object class="GtkBox">
                <property name="spacing">3</property>
                <child>
                  <object class="RnCanvasMenu" id="canvasmenu">
                    <property name="tooltip-text" translatable="yes">Canvas Menu</property>
                  </object>
                </child>
                <child>
                  <object class="RnAppMenu" id="appmenu">
                    <property name="tooltip-text" translatable="yes">App Menu</property>
                  </object>
                </child>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </template>
</interface>
